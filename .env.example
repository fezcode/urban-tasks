# Database
POSTGRES_USER=urban
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=urban_tasks
POSTGRES_PORT=5432
DATABASE_URL=postgres://urban:your_secure_password_here@localhost:5432/urban_tasks?sslmode=disable

# Auth
JWT_SECRET=replace_with_a_random_64_char_string_minimum_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Server
PORT=8080
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_RPS=100
SHUTDOWN_TIMEOUT=10s

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
